# Server configuration. Copy to .env (git-ignored) or set in your service manager.
# Secrets have no defaults anywhere in the code: a unit without a DSN cannot be queried.

# ---- knowledge and policy -------------------------------------------------------------
GM_KNOWLEDGE_PATH=examples/knowledge
GM_POLICY_PATH=examples/access.yaml
# Server-local state, kept outside the deployed tree so a deploy cannot overwrite it.
# GM_OVERLAY_PATH=~/.governed-metrics/overlay.jsonl
# GM_AUDIT_LOG=~/.governed-metrics/audit.jsonl

# ---- warehouse: one read-only role per unit (ADR 0006) --------------------------------
# Local demo (examples/warehouse). In production use sslmode=verify-full.
GM_DSN_UNIT_A=postgresql://gm_unit_a_ro:<password>@127.0.0.1:55432/governed_demo?sslmode=disable
GM_DSN_UNIT_B=postgresql://gm_unit_b_ro:<password>@127.0.0.1:55432/governed_demo?sslmode=disable
# GM_STATEMENT_TIMEOUT_MS=30000

# ---- transport ------------------------------------------------------------------------
# stdio for local use; the caller is GM_LOCAL_USER and the policy still applies.
GM_TRANSPORT=stdio
GM_LOCAL_USER=lead@example.com

# streamable-http behind a TLS-terminating proxy. Refuses to start without JWT auth.
# GM_TRANSPORT=streamable-http
# GM_HOST=127.0.0.1
# GM_PORT=8080
# GM_PUBLIC_URL=https://metrics.example.com
# GM_AUTH_MODE=jwt
# GM_JWT_ISSUER=https://idp.example.com/
# GM_JWT_AUDIENCE=governed-metrics
# GM_JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# GM_JWT_IDENTITY_CLAIM=email
# GM_ALLOWED_EMAIL_DOMAINS=example.com

# ---- admin console (behind the proxy's single sign-on) -------------------------------
# Both or neither, each at least 32 random characters, e.g. `openssl rand -hex 32`.
# GM_PROXY_SECRET=
# GM_CSRF_SECRET=
# GM_PROXY_USER_HEADER=x-forwarded-email

# ---- limits ---------------------------------------------------------------------------
# GM_ADHOC_ROW_CAP_DEFAULT=200
# GM_ADHOC_ROW_CAP_MAX=2000
# GM_BREAKDOWN_ROW_CAP=1000
# GM_ADHOC_RATE_PER_MINUTE=60
# GM_CACHE_TTL_S=300
