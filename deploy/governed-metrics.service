# systemd unit for the MCP server, fronted by a TLS-terminating reverse proxy.
#
#   sudo install -m 0644 deploy/governed-metrics.service /etc/systemd/system/
#   sudo install -d -m 0750 /etc/governed-metrics && sudoedit /etc/governed-metrics/env
#   sudo systemctl daemon-reload && sudo systemctl enable --now governed-metrics
#
# /etc/governed-metrics/env holds the secrets (GM_DSN_<UNIT>, GM_PROXY_SECRET, GM_CSRF_SECRET)
# and is readable by root and the service group only. scripts/deploy.sh switches
# /srv/governed-metrics/current between immutable releases and writes each release's version
# stamp to .release.env.
[Unit]
Description=Governed Metrics MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=governed-metrics
Group=governed-metrics
WorkingDirectory=/srv/governed-metrics/current
EnvironmentFile=/etc/governed-metrics/env
EnvironmentFile=-/srv/governed-metrics/current/.release.env
Environment=GM_TRANSPORT=streamable-http GM_HOST=127.0.0.1 GM_PORT=8080
# Point these at your own knowledge directory and policy; the examples run as shipped.
Environment=GM_KNOWLEDGE_PATH=/srv/governed-metrics/current/examples/knowledge
Environment=GM_POLICY_PATH=/srv/governed-metrics/current/examples/access.yaml
Environment=GM_OVERLAY_PATH=/var/lib/governed-metrics/overlay.jsonl
Environment=GM_AUDIT_LOG=/var/lib/governed-metrics/audit.jsonl
ExecStart=/srv/governed-metrics/current/.venv/bin/governed-metrics
Restart=on-failure
RestartSec=3

# State lives outside the release tree, so a deploy can never overwrite it.
StateDirectory=governed-metrics
StateDirectoryMode=0700
UMask=0077

# Least privilege for the process itself.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
